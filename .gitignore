# ─────────────────────────────────────────────────────────────
# Large source-data inputs — kept on local disk, NOT in git.
# (These are static regulatory filings; some exceed GitHub's 100 MB
#  per-file limit, and together they're ~2.5 GB. The dashboard's
#  derived data/images ARE committed, so the app works from a clone.)
# ─────────────────────────────────────────────────────────────
/Embassy/
/MindSpace/
/Brookfield/
/Nexus/
/KRT/
/Bagmane/

# Old/heavyweight copies & archives
dashboard.zip

# Raw slide/source assets (the derived PNGs under dashboard_v2/public/img ARE tracked)
*.key
*.pptx

# ─────────────────────────────────────────────────────────────
# OS / Python / editor cruft
# ─────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# ─────────────────────────────────────────────────────────────
# Scratch / diagnostic image exports in the app's image folder
# (underscore-prefixed working files, not part of the app)
# ─────────────────────────────────────────────────────────────
dashboard_v2/public/img/**/_*
